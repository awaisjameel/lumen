{
  "name": "lumen-frontend",
  "private": true,
  "version": "0.0.0",
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0",
    "npm": ">=11.19.0"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "build:dev": "vue-tsc --noEmit && vite build --minify false --mode development",
    "build": "vue-tsc --noEmit && vite build --mode production",
    "preview": "vite preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "vue-tsc --noEmit && eslint . --max-warnings 0 && prettier --check ."
  },
  "dependencies": {
    "@iconify/vue": "^5.0.3",
    "@nuxt/ui": "^4.11.2",
    "@tanstack/vue-virtual": "^3.13.39",
    "@vueuse/core": "^14.4.0",
    "@wailsio/runtime": "3.0.0-beta.26",
    "pinia": "^4.0.3",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@iconify-json/lucide": "^1.2.137",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/eslint-config-typescript": "14.9.0",
    "@vue/test-utils": "2.5.1",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.11.0",
    "globals": "17.12.0",
    "jsdom": "30.1.0",
    "prettier": "3.9.8",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "^8.3.1",
    "vitest": "5.0.1",
    "vue-tsc": "^3.3.11"
  },
  "overrides": {
    "esbuild": "0.28.2",
    "@typescript-eslint/eslint-plugin": "8.70.0",
    "@typescript-eslint/parser": "8.70.0",
    "@typescript-eslint/project-service": "8.70.0",
    "@typescript-eslint/scope-manager": "8.70.0",
    "@typescript-eslint/tsconfig-utils": "8.70.0",
    "@typescript-eslint/type-utils": "8.70.0",
    "@typescript-eslint/types": "8.70.0",
    "@typescript-eslint/typescript-estree": "8.70.0",
    "@typescript-eslint/utils": "8.70.0",
    "@typescript-eslint/visitor-keys": "8.70.0"
  }
}
