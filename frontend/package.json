{
  "name": "lumen-frontend",
  "private": true,
  "version": "0.0.0",
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1",
    "npm": ">=12.2.1"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "build:dev": "vue-tsc --noEmit && vite build --minify false --mode development",
    "build": "vue-tsc --noEmit && vite build --mode production",
    "preview": "vite preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "vue-tsc --noEmit && eslint . --max-warnings 0 && prettier --check ."
  },
  "dependencies": {
    "@iconify/vue": "^5.0.3",
    "@nuxt/ui": "^4.12.0",
    "@tanstack/vue-virtual": "^3.13.46",
    "@vueuse/core": "^15.0.0",
    "@wailsio/runtime": "3.0.0-beta.30",
    "pinia": "^4.1.0",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@iconify-json/lucide": "^1.2.144",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/eslint-config-typescript": "14.9.0",
    "@vue/test-utils": "2.5.1",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.11.1",
    "globals": "17.13.0",
    "jsdom": "30.1.2",
    "prettier": "3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "^8.3.4",
    "vitest": "5.0.4",
    "vue-tsc": "^3.3.13"
  },
  "overrides": {
    "esbuild": "0.28.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "vue-demi@0.14.10": true
  }
}
